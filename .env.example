# Copy to .env and fill in what you have. Everything is optional:
# with nothing set, `make demo` uses a stub judge and writes Slack payloads to out/slack/.

# LLM judge. Unset = deterministic stub.
OPENAI_API_KEY=
OPENAI_MODEL=

# Slack, best option first. A bot token + channel returns message timestamps,
# which is what lets 👍 / 👎 reactions be read back for --report.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Or a plain Incoming Webhook: delivers, but no feedback loop.
SLACK_WEBHOOK_URL=

# Optional overrides.
JOBSCOUT_CONFIG=
